# Copy to .env and fill in. Never commit .env itself (see .gitignore).

SAYARI_CLIENT_ID=
SAYARI_CLIENT_SECRET=

# Optional -- only needed for the risk-narrative generation step.
ANTHROPIC_API_KEY=

# Optional overrides, default to Sayari's production API.
